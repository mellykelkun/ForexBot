# ══════════════════════════════════════════════════════════
# FOREXBOT SAAS — FICHIER .env EXEMPLE
# Copiez ce fichier en .env et remplissez vos valeurs
# NE JAMAIS COMMITTER le .env avec vos secrets !
# ══════════════════════════════════════════════════════════

# ── MT5 (obligatoire en mode REAL) ───────────────────────
MT5_LOGIN=YOUR_LOGIN
MT5_PASSWORD=YOUR_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER

# ── Général ──────────────────────────────────────────────
DASHBOARD_SECRET=CHANGE_ME
FLASK_DEBUG=0
TRADING_MODE=REAL

# ── Trading ──────────────────────────────────────────────
INITIAL_CAPITAL=1000.0
RISK_PER_TRADE=0.5

# ── AI Engine ────────────────────────────────────────────
AI_MODEL_SAVE_PATH=./models/
AI_TRAINING_DB=ai_training.db

# ── Providers IA (multi-provider : Groq / OpenAI / DeepSeek) ──
# Groq (défaut)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI GPT
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat

# Provider actif (groq, openai, deepseek)
ACTIVE_AI_PROVIDER=groq

# ── Risk & fréquence ─────────────────────────────────────
MAX_TRADES_PER_HOUR=6
MAX_TRADES_PER_DAY=60
MIN_SECONDS_BETWEEN_TRADES=15
MAX_DAILY_LOSS_PCT=2.0
MAX_SLIPPAGE_POINTS=25
MAX_LATENCY_MS=800
COMMISSION_PER_LOT=0.0
SIMULATED_SLIPPAGE_POINTS=5
DECISION_INTERVAL_SECONDS=10
REQUIRED_CONFIDENCE=0.90
MAX_SPREAD_POINTS=100

# ── Bougies (historique) ─────────────────────────────────
BARS_M1=1000
BARS_M5=1000
BARS_H1=2000
BARS_H4=2000
BARS_D1=2000

# ── Log purge ────────────────────────────────────────────
LOG_PURGE_INTERVAL_MINUTES=10
LOG_PURGE_MAX_MB=50

# ── Sécurité ForexBot SaaS ───────────────────────────────
# Générés automatiquement par generate_access_key.py
ACCESS_KEY_HASH=
API_SECRET_TOKEN=
FLASK_SECRET_KEY=
